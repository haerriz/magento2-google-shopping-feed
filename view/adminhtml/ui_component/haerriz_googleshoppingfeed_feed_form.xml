            <item name="formElement" xsi:type="string">input</item><item name="source" xsi:type="string">profile</item>
        </item></argument></field>
        <field name="timezone">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Locale\Timezone</item>
                <item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">Schedule Timezone</item><item name="formElement" xsi:type="string">select</item><item name="source" xsi:type="string">profile</item><item name="filterOptions" xsi:type="boolean">true</item></item>
            </argument>
        </field>
        <field name="max_retries"><argument name="data" xsi:type="array"><item name="config" xsi:type="array">
            <item name="label" xsi:type="string" translate="true">Maximum Retries</item><item name="formElement" xsi:type="string">input</item><item name="dataType" xsi:type="string">number</item><item name="source" xsi:type="string">profile</item>
