        </argument>
        <field name="frequency" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="array">
                    <item name="manual" xsi:type="array"><item name="value" xsi:type="string">manual</item><item name="label" xsi:type="string" translate="true">Manual only</item></item>
                    <item name="hourly" xsi:type="array"><item name="value" xsi:type="string">hourly</item><item name="label" xsi:type="string" translate="true">Hourly</item></item>
                    <item name="daily" xsi:type="array"><item name="value" xsi:type="string">daily</item><item name="label" xsi:type="string" translate="true">Daily</item></item>
                    <item name="weekly" xsi:type="array"><item name="value" xsi:type="string">weekly</item><item name="label" xsi:type="string" translate="true">Weekly</item></item>
                    <item name="monthly" xsi:type="array"><item name="value" xsi:type="string">monthly</item><item name="label" xsi:type="string" translate="true">Monthly</item></item>
                    <item name="custom" xsi:type="array"><item name="value" xsi:type="string">custom</item><item name="label" xsi:type="string" translate="true">Custom cron expression</item></item>
                </item>
                <item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">Schedule</item><item name="source" xsi:type="string">profile</item></item>
            </argument>
        </field>
