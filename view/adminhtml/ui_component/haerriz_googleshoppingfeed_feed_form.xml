<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">haerriz_googleshoppingfeed_feed_form.feed_profile_form_data_source</item>
            <item name="deps" xsi:type="string">haerriz_googleshoppingfeed_feed_form.feed_profile_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Feed Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">haerriz_googleshoppingfeed_feed_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Haerriz\GoogleShoppingFeed\Block\Adminhtml\Feed\Edit\BackButton</item>
            <item name="save" xsi:type="string">Haerriz\GoogleShoppingFeed\Block\Adminhtml\Feed\Edit\SaveButton</item>
        </item>
    </argument>
    <dataSource name="feed_profile_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Haerriz\GoogleShoppingFeed\Model\FeedProfile\DataProvider</argument>
            <argument name="name" xsi:type="string">feed_profile_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">profile_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="*/*/save"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">1. General Settings</item>
            </item>
        </argument>
        <field name="profile_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">profile</item>
                </item>
            </argument>
        </field>
        <field name="name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Feed Name</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="status">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Haerriz\GoogleShoppingFeed\Model\Config\Source\Status</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">number</item>
                    <item name="label" xsi:type="string" translate="true">Status</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
            </argument>
        </field>
        <field name="filename">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Filename</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="notice" xsi:type="string">E.g., google_feed.xml</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="feed_type">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Haerriz\GoogleShoppingFeed\Model\Config\Source\FeedType</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Feed Format</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
            </argument>
        </field>
        <field name="store_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Store\Ui\Component\Listing\Column\Store\Options</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Store View</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="sortOrder" xsi:type="number">25</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="currency">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Locale\Currency</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Currency</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="sortOrder" xsi:type="number">26</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="locale">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Locale</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Locale</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="validation" xsi:type="array"><item name="required-entry" xsi:type="boolean">true</item></item>
                </item>
            </argument>
        </field>
        <field name="target_country">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Directory\Model\Config\Source\Country</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Target Country</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="validation" xsi:type="array"><item name="required-entry" xsi:type="boolean">true</item></item>
                </item>
            </argument>
        </field>
        <field name="content_language">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Content Language</item>
                <item name="notice" xsi:type="string" translate="true">ISO language code, for example en or en-GB.</item>
                <item name="formElement" xsi:type="string">input</item><item name="dataType" xsi:type="string">text</item>
                <item name="source" xsi:type="string">profile</item>
                <item name="validation" xsi:type="array"><item name="required-entry" xsi:type="boolean">true</item></item>
            </item></argument>
        </field>
        <field name="channel">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Channel / Template</item>
                <item name="formElement" xsi:type="string">input</item><item name="dataType" xsi:type="string">text</item>
                <item name="source" xsi:type="string">profile</item><item name="disabled" xsi:type="boolean">true</item>
            </item></argument>
        </field>
        <field name="template_version">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Pinned Template Version</item>
                <item name="formElement" xsi:type="string">input</item><item name="dataType" xsi:type="string">text</item>
                <item name="source" xsi:type="string">profile</item><item name="validation" xsi:type="array"><item name="required-entry" xsi:type="boolean">true</item></item>
            </item></argument>
        </field>
        <field name="delimiter">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Delimiter</item><item name="formElement" xsi:type="string">input</item>
                <item name="dataType" xsi:type="string">text</item><item name="source" xsi:type="string">profile</item>
            </item></argument>
        </field>
        <field name="enclosure">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Enclosure</item><item name="formElement" xsi:type="string">input</item>
                <item name="dataType" xsi:type="string">text</item><item name="source" xsi:type="string">profile</item>
            </item></argument>
        </field>
        <field name="line_ending" formElement="select">
            <argument name="data" xsi:type="array"><item name="options" xsi:type="array">
                <item name="lf" xsi:type="array"><item name="value" xsi:type="string">LF</item><item name="label" xsi:type="string">LF</item></item>
                <item name="crlf" xsi:type="array"><item name="value" xsi:type="string">CRLF</item><item name="label" xsi:type="string">CRLF</item></item>
            </item><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">Line Ending</item><item name="source" xsi:type="string">profile</item></item></argument>
        </field>
        <field name="encoding">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Encoding</item><item name="notice" xsi:type="string" translate="true">UTF-8 is required for XML and JSON Lines.</item>
                <item name="formElement" xsi:type="string">input</item><item name="source" xsi:type="string">profile</item>
            </item></argument>
        </field>
    </fieldset>
    <fieldset name="conditions">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">2. Product Filtering Conditions</item>
            </item>
        </argument>
        <field name="include_category_ids" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Haerriz\GoogleShoppingFeed\Model\Config\Source\Category</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Include Categories</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="chipsEnabled" xsi:type="boolean">true</item>
                </item>
            </argument>
        </field>
        <field name="exclude_category_ids" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Haerriz\GoogleShoppingFeed\Model\Config\Source\Category</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Exclude Categories</item>
                    <item name="source" xsi:type="string">profile</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="chipsEnabled" xsi:type="boolean">true</item>
                </item>
            </argument>
        </field>
        <field name="include_category_descendants" formElement="checkbox">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Include Descendant Categories</item>
                <item name="source" xsi:type="string">profile</item><item name="prefer" xsi:type="string">toggle</item>
                <item name="valueMap" xsi:type="array"><item name="false" xsi:type="number">0</item><item name="true" xsi:type="number">1</item></item>
            </item></argument>
        </field>
        <field name="include_disabled" formElement="checkbox">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Include Disabled Products</item>
                <item name="source" xsi:type="string">profile</item><item name="prefer" xsi:type="string">toggle</item>
                <item name="valueMap" xsi:type="array"><item name="false" xsi:type="number">0</item><item name="true" xsi:type="number">1</item></item>
            </item></argument>
        </field>
        <field name="visibility_values">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Visibility Values</item>
                <item name="notice" xsi:type="string" translate="true">Comma-separated Magento visibility IDs (1–4).</item>
                <item name="formElement" xsi:type="string">input</item><item name="source" xsi:type="string">profile</item>
            </item></argument>
        </field>
        <field name="stock_policy" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="array">
                    <item name="in_stock" xsi:type="array"><item name="value" xsi:type="string">in_stock</item><item name="label" xsi:type="string" translate="true">In stock only</item></item>
                    <item name="out_of_stock" xsi:type="array"><item name="value" xsi:type="string">out_of_stock</item><item name="label" xsi:type="string" translate="true">Out of stock only</item></item>
                    <item name="all" xsi:type="array"><item name="value" xsi:type="string">all</item><item name="label" xsi:type="string" translate="true">All stock states</item></item>
                </item>
                <item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">Stock Eligibility</item><item name="source" xsi:type="string">profile</item></item>
            </argument>
        </field>
        <field name="configurable_strategy" formElement="select">
            <argument name="data" xsi:type="array"><item name="options" xsi:type="array">
                <item name="parent" xsi:type="array"><item name="value" xsi:type="string">parent</item><item name="label" xsi:type="string" translate="true">Parent only</item></item>
                <item name="variants" xsi:type="array"><item name="value" xsi:type="string">variants</item><item name="label" xsi:type="string" translate="true">Salable variants</item></item>
                <item name="both" xsi:type="array"><item name="value" xsi:type="string">both</item><item name="label" xsi:type="string" translate="true">Parent and variants</item></item>
            </item><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">Configurable Products</item><item name="source" xsi:type="string">profile</item></item></argument>
        </field>
        <field name="bundle_strategy" formElement="select">
            <argument name="data" xsi:type="array"><item name="options" xsi:type="array">
                <item name="parent" xsi:type="array"><item name="value" xsi:type="string">parent</item><item name="label" xsi:type="string" translate="true">Parent only</item></item>
                <item name="children" xsi:type="array"><item name="value" xsi:type="string">children</item><item name="label" xsi:type="string" translate="true">Children only</item></item>
                <item name="both" xsi:type="array"><item name="value" xsi:type="string">both</item><item name="label" xsi:type="string" translate="true">Parent and children</item></item>
            </item><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">Bundle Products</item><item name="source" xsi:type="string">profile</item></item></argument>
        </field>
        <field name="grouped_strategy" formElement="select">
            <argument name="data" xsi:type="array"><item name="options" xsi:type="array">
                <item name="parent" xsi:type="array"><item name="value" xsi:type="string">parent</item><item name="label" xsi:type="string" translate="true">Parent only</item></item>
                <item name="children" xsi:type="array"><item name="value" xsi:type="string">children</item><item name="label" xsi:type="string" translate="true">Children only</item></item>
                <item name="both" xsi:type="array"><item name="value" xsi:type="string">both</item><item name="label" xsi:type="string" translate="true">Parent and children</item></item>
            </item><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">Grouped Products</item><item name="source" xsi:type="string">profile</item></item></argument>
        </field>
        <field name="include_virtual" formElement="checkbox">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Include Virtual Products</item><item name="source" xsi:type="string">profile</item>
                <item name="prefer" xsi:type="string">toggle</item><item name="valueMap" xsi:type="array"><item name="false" xsi:type="number">0</item><item name="true" xsi:type="number">1</item></item>
            </item></argument>
        </field>
        <field name="include_downloadable" formElement="checkbox">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Include Downloadable Products</item><item name="source" xsi:type="string">profile</item>
                <item name="prefer" xsi:type="string">toggle</item><item name="valueMap" xsi:type="array"><item name="false" xsi:type="number">0</item><item name="true" xsi:type="number">1</item></item>
            </item></argument>
        </field>
        <htmlContent name="html_content">
            <argument name="block" xsi:type="object">Haerriz\GoogleShoppingFeed\Block\Adminhtml\Feed\Edit\Tab\Conditions</argument>
        </htmlContent>
    </fieldset>
    <fieldset name="mapping">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">3. Attribute Mapping</item>
            </item>
        </argument>
        <!-- Enterprise Feature: Dynamic Rows for Attribute Mapping -->
        <dynamicRows name="attributes_mapping">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="addButtonLabel" xsi:type="string" translate="true">Add Attribute Mapping</item>
                    <item name="componentType" xsi:type="string">dynamicRows</item>
                    <item name="itemTemplate" xsi:type="string">record</item>
                </item>
            </argument>
            <container name="record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="google_attribute">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="formElement" xsi:type="string">input</item>
                            <item name="label" xsi:type="string" translate="true">Google Attribute (e.g. g:title)</item>
                            <item name="dataScope" xsi:type="string">google_attribute</item>
                        </item>
                    </argument>
                </field>
                <field name="magento_attribute">
                    <argument name="data" xsi:type="array">
                        <item name="options" xsi:type="object">Haerriz\GoogleShoppingFeed\Model\Config\Source\ProductAttribute</item>
                        <item name="config" xsi:type="array">
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="formElement" xsi:type="string">select</item>
                            <item name="label" xsi:type="string" translate="true">Magento Attribute</item>
                            <item name="dataScope" xsi:type="string">magento_attribute</item>
                            <item name="filterOptions" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                </field>
                <field name="default_value">
                    <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                        <item name="dataType" xsi:type="string">text</item><item name="formElement" xsi:type="string">input</item>
                        <item name="label" xsi:type="string" translate="true">Fallback / Default</item><item name="dataScope" xsi:type="string">default_value</item>
                    </item></argument>
                </field>
                <field name="modifier">
                    <argument name="data" xsi:type="array">
                        <item name="options" xsi:type="object">Haerriz\GoogleShoppingFeed\Model\Config\Source\Modifier</item>
                        <item name="config" xsi:type="array">
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="formElement" xsi:type="string">select</item>
                            <item name="label" xsi:type="string" translate="true">Modifier</item>
                            <item name="dataScope" xsi:type="string">modifier</item>
                        </item>
                    </argument>
                </field>
                <actionDelete>
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="componentType" xsi:type="string">actionDelete</item>
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="label" xsi:type="string" translate="true">Actions</item>
                        </item>
                    </argument>
                </actionDelete>
            </container>
        </dynamicRows>
    </fieldset>
    <fieldset name="transformations">
        <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">4. Optional Details and Transformations</item></item></argument>
        <field name="utm_enabled" formElement="checkbox">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Enable UTM Tracking</item><item name="source" xsi:type="string">profile</item>
                <item name="prefer" xsi:type="string">toggle</item><item name="valueMap" xsi:type="array"><item name="false" xsi:type="number">0</item><item name="true" xsi:type="number">1</item></item>
            </item></argument>
        </field>
        <field name="utm_source"><argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">UTM Source</item><item name="formElement" xsi:type="string">input</item><item name="source" xsi:type="string">profile</item></item></argument></field>
        <field name="utm_medium"><argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">UTM Medium</item><item name="formElement" xsi:type="string">input</item><item name="source" xsi:type="string">profile</item></item></argument></field>
        <field name="utm_campaign"><argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">UTM Campaign</item><item name="formElement" xsi:type="string">input</item><item name="source" xsi:type="string">profile</item></item></argument></field>
        <field name="utm_term"><argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="label" xsi:type="string" translate="true">UTM Term</item><item name="formElement" xsi:type="string">input</item><item name="source" xsi:type="string">profile</item></item></argument></field>
