<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="haerriz_google_shopping_feed_profile" resource="default" engine="innodb" comment="Google Shopping Feed Profiles">
        <column xsi:type="int" name="profile_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Feed Name"/>
        <column xsi:type="smallint" name="status" padding="6" unsigned="true" nullable="false" default="0" comment="Status"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false" default="0" comment="Store View ID"/>
        <column xsi:type="varchar" name="currency" nullable="false" length="3" default="USD" comment="Currency"/>
        <column xsi:type="varchar" name="locale" nullable="false" length="16" default="en_US" comment="Profile Locale"/>
        <column xsi:type="varchar" name="target_country" nullable="false" length="2" default="US" comment="Target Country"/>
        <column xsi:type="varchar" name="content_language" nullable="false" length="16" default="en" comment="Content Language"/>
        <column xsi:type="varchar" name="channel" nullable="false" length="64" default="google" comment="Feed Channel"/>
        <column xsi:type="varchar" name="template_version" nullable="false" length="32" default="1" comment="Pinned Template Version"/>
        <column xsi:type="varchar" name="filename" nullable="false" length="255" comment="Filename"/>
        <column xsi:type="varchar" name="feed_type" nullable="false" length="50" default="csv" comment="Feed Format (csv, xml)"/>
        <column xsi:type="varchar" name="delimiter" nullable="false" length="8" default="," comment="Delimited Output Delimiter"/>
        <column xsi:type="varchar" name="enclosure" nullable="false" length="8" default="&quot;" comment="Delimited Output Enclosure"/>
        <column xsi:type="varchar" name="line_ending" nullable="false" length="16" default="LF" comment="Output Line Ending"/>
        <column xsi:type="varchar" name="encoding" nullable="false" length="32" default="UTF-8" comment="Output Encoding"/>
        <column xsi:type="varchar" name="compression" nullable="false" length="16" default="none" comment="Artifact Compression"/>
        <column xsi:type="int" name="max_products_per_file" unsigned="true" nullable="false" default="0" comment="Maximum Products Per File"/>
        <column xsi:type="bigint" name="max_bytes_per_file" unsigned="true" nullable="false" default="0" comment="Maximum Uncompressed Bytes Per File"/>
        <column xsi:type="mediumtext" name="conditions_serialized" nullable="true" comment="Product Filter Conditions"/>
        <column xsi:type="text" name="include_category_ids" nullable="true" comment="Included Category IDs"/>
        <column xsi:type="text" name="exclude_category_ids" nullable="true" comment="Excluded Category IDs"/>
        <column xsi:type="smallint" name="include_category_descendants" unsigned="true" nullable="false" default="1" comment="Include Category Descendants"/>
        <column xsi:type="smallint" name="include_disabled" unsigned="true" nullable="false" default="0" comment="Include Disabled Products"/>
        <column xsi:type="varchar" name="visibility_values" nullable="false" length="64" default="2,3,4" comment="Allowed Visibility Values"/>
        <column xsi:type="varchar" name="stock_policy" nullable="false" length="32" default="in_stock" comment="Stock Eligibility Policy"/>
        <column xsi:type="mediumtext" name="attributes_mapping_serialized" nullable="true" comment="Attributes Mapping"/>
        <column xsi:type="mediumtext" name="conditional_values_serialized" nullable="true" comment="Conditional Mapping Values"/>
        <column xsi:type="mediumtext" name="modifier_chains_serialized" nullable="true" comment="Ordered Modifier Chains"/>
        <column xsi:type="varchar" name="configurable_strategy" nullable="false" length="32" default="parent" comment="Configurable Product Strategy"/>
        <column xsi:type="varchar" name="bundle_strategy" nullable="false" length="32" default="parent" comment="Bundle Product Strategy"/>
        <column xsi:type="varchar" name="grouped_strategy" nullable="false" length="32" default="parent" comment="Grouped Product Strategy"/>
        <column xsi:type="smallint" name="include_virtual" unsigned="true" nullable="false" default="0" comment="Include Virtual Products"/>
        <column xsi:type="smallint" name="include_downloadable" unsigned="true" nullable="false" default="0" comment="Include Downloadable Products"/>
        <column xsi:type="varchar" name="delivery_type" nullable="false" length="32" default="local" comment="Delivery Type"/>
        <column xsi:type="varchar" name="delivery_host" nullable="true" length="255" comment="Delivery Host"/>
        <column xsi:type="int" name="delivery_port" padding="5" unsigned="true" nullable="true" comment="Delivery Port"/>
        <column xsi:type="varchar" name="delivery_username" nullable="true" length="255" comment="Delivery Username"/>
        <column xsi:type="text" name="delivery_password" nullable="true" comment="Delivery Password"/>
        <column xsi:type="varchar" name="delivery_path" nullable="true" length="255" comment="Delivery Path"/>
        <column xsi:type="int" name="delivery_timeout" unsigned="true" nullable="false" default="20" comment="Delivery Timeout Seconds"/>
        <column xsi:type="smallint" name="ftp_passive" unsigned="true" nullable="false" default="1" comment="FTP Passive Mode"/>
        <column xsi:type="varchar" name="remote_filename" nullable="true" length="255" comment="Remote Filename"/>
        <column xsi:type="varchar" name="sftp_fingerprint" nullable="true" length="255" comment="SFTP Host Fingerprint"/>
        <column xsi:type="varchar" name="cron_expression" nullable="true" length="128" comment="Custom Cron Expression"/>
        <column xsi:type="varchar" name="frequency" nullable="true" length="32" comment="Cron Frequency"/>
        <column xsi:type="varchar" name="timezone" nullable="true" length="64" comment="Timezone"/>
        <column xsi:type="timestamp" name="next_run_at" nullable="true" comment="Next Scheduled Run"/>
        <column xsi:type="varchar" name="concurrency_policy" nullable="false" length="32" default="skip" comment="Concurrency Policy"/>
        <column xsi:type="varchar" name="missed_run_policy" nullable="false" length="32" default="next" comment="Missed Run Policy"/>
        <column xsi:type="int" name="max_retries" padding="5" unsigned="true" nullable="false" default="3" comment="Max Retries"/>
        <column xsi:type="int" name="retry_count" padding="5" unsigned="true" nullable="false" default="0" comment="Current Retry Count"/>
        <column xsi:type="int" name="consecutive_failures" padding="5" unsigned="true" nullable="false" default="0" comment="Consecutive Failures Count"/>
        <column xsi:type="smallint" name="is_locked" padding="5" unsigned="true" nullable="false" default="0" comment="Is Running Lock"/>
        <column xsi:type="timestamp" name="locked_at" nullable="true" comment="Lock Time"/>
        <column xsi:type="smallint" name="utm_enabled" padding="5" unsigned="true" nullable="false" default="0" comment="Enable UTM Tracking"/>
        <column xsi:type="varchar" name="utm_source" nullable="true" length="128" comment="UTM Source"/>
        <column xsi:type="varchar" name="utm_medium" nullable="true" length="128" comment="UTM Medium"/>
        <column xsi:type="varchar" name="utm_campaign" nullable="true" length="128" comment="UTM Campaign"/>
        <column xsi:type="varchar" name="utm_term" nullable="true" length="128" comment="UTM Term"/>
        <column xsi:type="varchar" name="utm_content" nullable="true" length="128" comment="UTM Content"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="profile_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="HAERRIZ_GSF_PROFILE_STORE_ID_STORE_STORE_ID" table="haerriz_google_shopping_feed_profile" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>

    <table name="haerriz_google_shopping_feed_job" resource="default" engine="innodb" comment="Google Shopping Feed Jobs">
        <column xsi:type="int" name="job_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Job ID"/>
        <column xsi:type="int" name="profile_id" padding="10" unsigned="true" nullable="true" comment="Profile ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="50" default="pending" comment="Job Status"/>
        <column xsi:type="int" name="total_products" padding="10" unsigned="true" nullable="false" default="0" comment="Total Products"/>
        <column xsi:type="int" name="processed_products" padding="10" unsigned="true" nullable="false" default="0" comment="Processed Products"/>
        <column xsi:type="varchar" name="trigger_source" nullable="false" length="32" default="cron" comment="Trigger Source"/>
        <column xsi:type="int" name="selected_count" padding="10" unsigned="true" nullable="false" default="0" comment="Selected Products Count"/>
        <column xsi:type="int" name="exported_count" padding="10" unsigned="true" nullable="false" default="0" comment="Exported Products Count"/>
        <column xsi:type="int" name="skipped_count" padding="10" unsigned="true" nullable="false" default="0" comment="Skipped Products Count"/>
        <column xsi:type="int" name="warning_count" padding="10" unsigned="true" nullable="false" default="0" comment="Warnings Count"/>
        <column xsi:type="int" name="error_count" padding="10" unsigned="true" nullable="false" default="0" comment="Errors Count"/>
        <column xsi:type="bigint" name="file_size" unsigned="true" nullable="false" default="0" comment="Generated File Size"/>
        <column xsi:type="varchar" name="checksum" nullable="true" length="64" comment="Generated File Checksum"/>
        <column xsi:type="decimal" name="duration" scale="2" precision="10" nullable="false" default="0.00" comment="Duration in Seconds"/>
        <column xsi:type="bigint" name="peak_memory" unsigned="true" nullable="false" default="0" comment="Peak Memory in Bytes"/>
        <column xsi:type="varchar" name="delivery_result" nullable="true" length="255" comment="Delivery Result Summary"/>
        <column xsi:type="varchar" name="failure_category" nullable="true" length="64" comment="Failure Category"/>
        <column xsi:type="text" name="failure_message" nullable="true" comment="Redacted Failure Message"/>
        <column xsi:type="varchar" name="exception_class" nullable="true" length="255" comment="Exception Class"/>
        <column xsi:type="varchar" name="correlation_id" nullable="true" length="64" comment="Correlation ID"/>
        <column xsi:type="varchar" name="artifact_path" nullable="true" length="512" comment="Published Artifact Path"/>
        <column xsi:type="varchar" name="format" nullable="true" length="32" comment="Artifact Format"/>
        <column xsi:type="mediumtext" name="profile_snapshot" nullable="true" comment="Redacted Profile Configuration Snapshot"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="started_at" on_update="false" nullable="true" comment="Start Time"/>
        <column xsi:type="timestamp" name="finished_at" on_update="false" nullable="true" comment="Finish Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="job_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="HAERRIZ_GSF_JOB_PROFILE_ID_PROFILE_PROFILE_ID" table="haerriz_google_shopping_feed_job" column="profile_id" referenceTable="haerriz_google_shopping_feed_profile" referenceColumn="profile_id" onDelete="SET NULL"/>
    </table>

    <table name="haerriz_google_shopping_feed_log" resource="default" engine="innodb" comment="Google Shopping Feed Logs">
        <column xsi:type="int" name="log_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="int" name="profile_id" padding="10" unsigned="true" nullable="true" comment="Profile ID"/>
        <column xsi:type="int" name="job_id" padding="10" unsigned="true" nullable="true" comment="Job ID"/>
        <column xsi:type="varchar" name="type" nullable="false" length="50" default="info" comment="Log Type"/>
        <column xsi:type="text" name="message" nullable="false" comment="Log Message"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="HAERRIZ_GSF_LOG_PROFILE_ID_PROFILE_PROFILE_ID" table="haerriz_google_shopping_feed_log" column="profile_id" referenceTable="haerriz_google_shopping_feed_profile" referenceColumn="profile_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="HAERRIZ_GSF_LOG_JOB_ID_JOB_JOB_ID" table="haerriz_google_shopping_feed_log" column="job_id" referenceTable="haerriz_google_shopping_feed_job" referenceColumn="job_id" onDelete="CASCADE"/>
    </table>
</schema>
